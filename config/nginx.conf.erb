# Configuration du buildpack heroku-community/nginx.
#
# Le déploiement ne sert qu'un site statique : aucun processus applicatif, et
# aucun serveur écrit ici. nginx sert les fichiers de site/dist et rien d'autre.
#
# Sur un dyno Heroku, le dépôt est déposé dans /app — d'où la racine ci-dessous.

daemon off;
worker_processes 1;

events {
  use epoll;
  accept_mutex on;
  worker_connections 1024;
}

http {
  include mime.types;
  default_type application/octet-stream;

  server_tokens off;
  sendfile on;
  keepalive_timeout 5;

  gzip on;
  gzip_comp_level 5;
  gzip_min_length 256;
  gzip_proxied any;
  gzip_types
    text/plain text/css text/javascript
    application/javascript application/json image/svg+xml;

  access_log /dev/stdout;
  error_log /dev/stderr;

  server {
    listen <%= ENV["PORT"] %>;
    server_name _;
    root /app/site/dist;
    index index.html;

    # L'application web a vécu ici : ses anciennes adresses ramènent au site
    # plutôt que de tomber sur une erreur.
    location = /app            { return 301 /; }
    location ^~ /app/          { return 301 /; }
    location = /presentation   { return 301 /; }
    location ^~ /presentation/ { return 301 /; }

    # Service worker d'extinction : il retire celui que l'ancienne application
    # avait laissé à la racine. Toujours revalidé, sinon les navigateurs
    # garderaient l'ancien et continueraient d'afficher l'application en cache.
    location = /sw.js {
      add_header Cache-Control "no-cache" always;
    }

    location ~* \.html$ {
      add_header Cache-Control "no-cache" always;
    }

    # Le reste porte une empreinte dans son nom : gardable un an.
    location ~* \.(js|css|png|jpe?g|svg|webp|ico|woff2?)$ {
      add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location / {
      try_files $uri /index.html;
    }
  }
}
