# Configuration du buildpack heroku-community/nginx.
#
# Le déploiement ne sert plus qu'un site statique : aucun serveur applicatif, et
# donc plus de server.js. nginx sert les fichiers de site/dist et rien d'autre.
#
# Sur un dyno Heroku, le dépôt est déposé dans /app — d'où la racine ci-dessous,
# à ne pas confondre avec l'ancienne URL /app de l'application.

daemon off;
worker_processes 1;

events {
  use epoll;
  accept_mutex on;
  worker_connections 1024;
}

http {
  include mime.types;
  default_type application/octet-stream;

  # Absent des types par défaut, et nécessaire au manifeste d'une PWA.
  types {
    application/manifest+json webmanifest;
  }

  server_tokens off;
  sendfile on;
  keepalive_timeout 5;

  gzip on;
  gzip_comp_level 5;
  gzip_min_length 256;
  gzip_proxied any;
  gzip_types
    text/plain text/css text/javascript
    application/javascript application/json application/manifest+json
    image/svg+xml;

  access_log /dev/stdout;
  error_log /dev/stderr;

  server {
    listen <%= ENV["PORT"] %>;
    server_name _;
    root /app/site/dist;
    index index.html;

    # L'application n'est plus servie ici : elle vit à côté. Les anciennes
    # adresses ramènent au site plutôt que de tomber sur une erreur.
    location = /presentation   { return 301 /; }
    location ^~ /presentation/ { return 301 /; }
    location = /app            { return 301 /; }
    location ^~ /app/          { return 301 /; }

    # Service worker d'extinction : il retire celui que l'application avait
    # laissé à la racine. Il doit toujours être revalidé, sinon les navigateurs
    # garderaient l'ancien et continueraient d'afficher l'application en cache.
    location = /sw.js {
      add_header Cache-Control "no-cache" always;
    }

    # Les pages et le manifeste changent sans changer de nom : toujours revalider.
    location ~* \.(html|webmanifest)$ {
      add_header Cache-Control "no-cache" always;
    }

    # Le reste porte une empreinte dans son nom : gardable un an.
    location ~* \.(js|css|png|jpe?g|svg|webp|ico|woff2?)$ {
      add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location / {
      try_files $uri /index.html;
    }
  }
}
