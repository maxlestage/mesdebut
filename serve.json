{
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "type": 301
    },
    {
      "source": "/index",
      "destination": "/",
      "type": 301
    },
    {
      "source": "/app",
      "destination": "/",
      "type": 301
    },
    {
      "source": "/app/:reste*",
      "destination": "/",
      "type": 301
    },
    {
      "source": "/presentation",
      "destination": "/",
      "type": 301
    },
    {
      "source": "/presentation/:reste*",
      "destination": "/",
      "type": 301
    }
  ],
  "headers": [
    {
      "source": "sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "**/*.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "assets/**",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "icon.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
